{
    "name": "hlquery/php-client",
    "description": "PHP client library for hlquery search engine",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Carlos F. Ferry",
            "email": "carlos.ferry@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Hlquery\\": "lib/",
            "Hlquery\\Utils\\": "utils/"
        },
        "files": [
            "lib/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Hlquery\\Tests\\": "tests/"
        }
    }
}
